{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "new",
	"compatibility_date": "2026-11-20",
	"compatibility_flags": ["nodejs_als", "nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true
}

