{
	"name": "new",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"build:nowrangler": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"gen": "wrangler types",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"machine-translate": "inlang machine translate --project project.inlang"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261120.1",
		"@eslint/js": "^10.0.1",
		"@iconify-json/tabler": "^1.2.46",
		"@inlang/cli": "^3.6.0",
		"@inlang/paraglide-js": "^3.2.2",
		"@neondatabase/serverless": "^1.2.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.3.5",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24",
		"autoprefixer": "^10.7.0",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.23",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"drizzle-zod": "^0.8.3",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"lucide-svelte": "^1.0.1",
		"miniflare": "^5.20261117.0-beta",
		"nanoid": "^6.0.2",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sass-embedded": "^1.108.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"wrangler": "^4.162.0",
		"zod": "^4.6.7"
	},
	"dependencies": {
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"arctic": "^3.7.0",
		"fcm-cloudflare-workers": "^2.0.3",
		"firebase": "^13.4.0",
		"zod-validation-error": "^5.0.0"
	},
	"packageManager": "pnpm@12.0.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": ">=12.0.0 <13.0.0",
			"onFail": "download"
		}
	}
}
